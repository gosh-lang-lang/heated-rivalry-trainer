heated-rivalry-trainer.spill-the-tea.xyz {
	header {
		-Server
		-Via
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		X-Frame-Options "DENY"
	}
	# Прогресс пользователя растёт с занятиями (через полгода ~100 КБ); свои пределы у каждого метода ставит сервер
	# (app/server/progress.ts STATE_MAX_BYTES = 2 МБ, остальное — 8 КБ). Этот предел — не ниже серверного.
	request_body {
		max_size 3MB
	}

	# Вход — в приложении (passkey): без сессии сервер отдаёт только страницу входа, API — 401.
	# Закрыть сайт целиком (аварийно): на сервере /opt/vps-edge/bin/edge unregister heated-rivalry; вернуть — deploy/deploy.sh edge
	encode zstd gzip
	reverse_proxy heated-rivalry:8787
}
